# Copie para .env. Valores de ambiente prevalecem sobre o arquivo.
# Acesso público exige HTTPS e senha configurada por server/auth.py.
PUBLIC_URL=
# Hospedagem Docker/Caddy usa somente o domínio, sem https://.
ORBIT_DOMAIN=
ORBIT_DATA_DIR=
# Vazio preserva o banco legado em server/orbit.sqlite3.
ORBIT_DATABASE_PATH=
SESSION_HOURS=12
PUSH_INTERVAL_SECONDS=10
# Opcional após server/push.py --subject mailto:SEU_CONTATO
VAPID_SUBJECT=

# Motor editorial. O padrão rules executa somente regras locais.
ORBIT_AI_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Apenas para uma implantação que autorize explicitamente o host de rede privada.
ORBIT_OLLAMA_ALLOWED_HOSTS=
OLLAMA_MODEL=
ORBIT_OLLAMA_CPU=true
OPENAI_API_KEY=
OPENAI_MODEL=
ORBIT_AI_REMOTE_ENABLED=false
# Limite diário de chamadas OpenAI. Ollama local registra uso sem consumir essa cota.
ORBIT_AI_DAILY_REQUEST_LIMIT=20

# Preencha conforme aplicativo creator aprovado no TikTok Shop Partner Center.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_REQUIRED_SCOPES=
# Pasta contendo exportações JSON canônicas próprias, verificadas a cada 60s.
ORBIT_IMPORT_DIRECTORY=
ORBIT_IMPORT_INTERVAL_SECONDS=60
